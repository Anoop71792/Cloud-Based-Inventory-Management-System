# Copy to .env (never commit .env). Used for local development / docker compose.
# Production values come from Ansible Vault, not from this file.

SECRET_KEY=change-me-to-a-long-random-string-at-least-16-chars
COOKIE_SECURE=0

# MySQL (local server for development, or your RDS endpoint)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=inventorydb
DB_USER=inventoryuser
DB_PASSWORD=change-me

# verify-full (default, required for RDS) or disabled (local dev MySQL without TLS only)
DB_SSL_MODE=disabled
# DB_SSL_CA=/app/certs/rds-global-bundle.pem

# Optional pool / startup tuning (defaults shown)
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=5
# DB_POOL_RECYCLE=1800
# DB_POOL_TIMEOUT=30
# DB_CONNECT_TIMEOUT=10
# DB_STARTUP_ATTEMPTS=12
# DB_STARTUP_DELAY=5
